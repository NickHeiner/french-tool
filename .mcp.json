{
  "mcpServers": {
    "trigger-prod": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "trigger.dev@latest", "mcp"],
      "env": {
        "TRIGGER_SECRET_KEY": "${TRIGGER_SECRET_KEY_PROD}",
        "TRIGGER_PROJECT_ID": "${TRIGGER_PROJECT_ID}"
      }
    },
    "trigger-dev": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "trigger.dev@latest", "mcp"],
      "env": {
        "TRIGGER_SECRET_KEY": "${TRIGGER_SECRET_KEY_DEV}",
        "TRIGGER_PROJECT_ID": "${TRIGGER_PROJECT_ID}"
      }
    },
    "trigger-test-branch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "trigger.dev@latest", "mcp"],
      "env": {
        "TRIGGER_SECRET_KEY": "${TRIGGER_SECRET_KEY_TEST_BRANCH}",
        "TRIGGER_PROJECT_ID": "${TRIGGER_PROJECT_ID}"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
